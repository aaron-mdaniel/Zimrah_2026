{
  "version": 2,
  "name": "zimrah-2026",
  "framework": null,
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "https://zimrah-backend.onrender.com/static/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://zimrah-backend.onrender.com/media/$1"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://zimrah-backend.onrender.com/api/$1"
    },
    {
      "source": "/portal/(.*)",
      "destination": "https://zimrah-backend.onrender.com/portal/$1"
    },
    {
      "source": "/admin/(.*)",
      "destination": "https://zimrah-backend.onrender.com/admin/$1"
    },
    {
      "source": "/(.*)",
      "destination": "https://zimrah-backend.onrender.com/$1"
    }
  ],
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}
