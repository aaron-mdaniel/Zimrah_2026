# ==============================================================================
# ZIMRAH 2026 – PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# CSI Madhya Kerala Diocese, Adoor Clergy District Youth Movement
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE DJANGO SECURITY
# ------------------------------------------------------------------------------
# Set to 'False' in production environments (Render, production servers)
DEBUG=False

# Generate a strong, unique 50+ character random key in production
SECRET_KEY=replace-with-a-very-long-and-secure-random-secret-key-at-least-50-chars

# Comma-separated list of allowed hostnames (no protocol or trailing slashes)
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com,zimrah2026.example.com,api.zimrah2026.example.com,zimrah.vercel.app

# Comma-separated list of trusted origins for CSRF POST verification (MUST include scheme https://)
CSRF_TRUSTED_ORIGINS=https://*.onrender.com,https://zimrah2026.example.com,https://api.zimrah2026.example.com,https://*.vercel.app,http://127.0.0.1:8000,http://localhost:8000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (Managed PostgreSQL)
# ------------------------------------------------------------------------------
# On Render, Supabase, Neon, or Railway, use DATABASE_URL:
DATABASE_URL=postgresql://zimrah_user:your_secure_password@dpg-xxxxxx.frankfurt-postgres.render.com/zimrah_db

# Alternatively, set individual connection parameters if not using DATABASE_URL:
DB_NAME=zimrah_db
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_HOST=127.0.0.1
DB_PORT=5432

# DB connection persistence: 0 drops idle connections immediately (recommended with PgBouncer/Render pooler), 60 maintains persistent connections
CONN_MAX_AGE=0

# ------------------------------------------------------------------------------
# 3. HIGH-PERFORMANCE CACHING (In-Memory or Redis)
# ------------------------------------------------------------------------------
# If REDIS_URL is set, Django uses Redis for high-performance atomic cache busting
# REDIS_URL=redis://default:your_redis_password@redis-server.render.com:6379/0

# Fallback in-memory cache backend:
CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
CACHE_LOCATION=zimrah-cache
CACHE_TIMEOUT=300

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION (Cross-Origin Resource Sharing)
# ------------------------------------------------------------------------------
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://zimrah2026.example.com,https://zimrah.vercel.app,http://127.0.0.1:3000,http://localhost:3000

# ------------------------------------------------------------------------------
# 5. SSL & HTTPS SECURITY HEADERS
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=True
SECURE_HSTS=True
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# 7. AUTOMATED SUPER ADMIN SEEDING (Optional for first-time deploy)
# ------------------------------------------------------------------------------
# If set during build/deploy, python manage.py create_prod_admin initializes this account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@zimrah2026.org
ADMIN_PASSWORD=SetSecureSuperAdminPasswordHere123!
